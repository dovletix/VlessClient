<Window x:Class="VlessClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VlessClient" Width="1160" Height="760" MinWidth="930" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Background}"
        Loaded="WindowLoaded" Closed="WindowClosed">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="0,2,0,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RestartButton" Content="Перезапустить" Tag="restart" Click="ControlClick" Margin="0,0,8,0" IsEnabled="False" />
                    <Button x:Name="ConnectButton" Content="Подключить" Style="{StaticResource Primary}" Tag="start" Click="ControlClick" IsEnabled="False" />
                </StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="VlessClient" FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,15,0" />
                    <Border DockPanel.Dock="Left" x:Name="StatusPill" CornerRadius="20" Background="{DynamicResource Control}"
                            Padding="9,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock x:Name="ConnectionStatus" FontWeight="SemiBold" Text="Загрузка…" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ConnectionDetail" Style="{StaticResource MutedText}" Margin="14,0,12,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Pages" Grid.Row="1" Background="{DynamicResource Background}" BorderThickness="0"
                    Padding="0,12,0,0" SelectionChanged="TabChanged">
            <TabItem Header="Обзор" x:Name="ApplicationsPage">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,3,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Приложения" Style="{StaticResource SectionTitle}" />
                                <ListBox x:Name="AppRules" BorderThickness="0" SelectedValuePath="name" Background="Transparent"
                                         AutomationProperties.Name="Правила приложений" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Background="{DynamicResource Background}"
                                                    Width="252" Padding="11" Margin="0,0,6,4">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="×" ToolTip="Удалить правило"
                                                                AutomationProperties.Name="Удалить правило приложения"
                                                                Padding="6,0" MinHeight="24" Click="RemoveRuleClick" />
                                                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource Border}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding running}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource Ok}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding name}" FontWeight="SemiBold" FontSize="14"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Executables}" Style="{StaticResource MutedText}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,7" />
                                                    <ToggleButton Style="{StaticResource RouteSwitch}" IsChecked="{Binding vpn, Mode=OneWay}"
                                                                  Content="{Binding Route}" AutomationProperties.Name="{Binding name}"
                                                                  Click="ToggleRuleClick" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewExe" AutomationProperties.Name="Имя exe" Tag="Добавить вручную: имя.exe" MaxLength="104" />
                                    <Button Grid.Column="1" Content="Через VPN" Tag="vpn" Click="AddRuleClick" Margin="8,0,0,0" />
                                    <Button Grid.Column="2" Content="Напрямую" Tag="direct" Click="AddRuleClick" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10" LastChildFill="False">
                                    <Button DockPanel.Dock="Right" Content="Сбросить статистику" Click="ResetClick" />
                                    <TextBlock Text="Процессы" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBox x:Name="ProcessSearch" Width="175" AutomationProperties.Name="Поиск процессов"
                                             Tag="Поиск по имени" TextChanged="ProcessSearchChanged" MaxLength="100" />
                                    <CheckBox x:Name="AllProcesses" Content="Все запущенные" Margin="12,0,0,0" Click="RefreshClick" />
                                    <CheckBox x:Name="OnlyProblems" Content="Только с проблемами" Margin="12,0,0,0" Click="ProcessFilterClick" />
                                </DockPanel>
                                <DataGrid x:Name="ProcessGrid" MinHeight="115" MaxHeight="310" SelectionChanged="ProcessSelected">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Процесс" SortMemberPath="name" Width="2*" MinWidth="125">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding path}" FontSize="11" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Скорость, Мбит/с" Binding="{Binding Speed}" SortMemberPath="TotalRate" Width="133" />
                                        <DataGridTextColumn Header="Всего" Binding="{Binding Volume}" SortMemberPath="TotalBytes" Width="86" />
                                        <DataGridTextColumn Header="Соединения" Binding="{Binding Connections}" SortMemberPath="active" Width="95" />
                                        <DataGridTextColumn Header="Куда идёт" Binding="{Binding TrafficByRoute}" SortMemberPath="pBytes" Width="2*" MinWidth="115" />
                                        <DataGridTextColumn Header="Проблемы" Binding="{Binding Problems}" SortMemberPath="ProblemCount" Width="114" />
                                        <DataGridTextColumn Header="Маршрут" Binding="{Binding Route}" Width="94" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DockPanel Margin="0,10,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="ProcessVpn" Content="Через VPN" Tag="vpn" Click="RouteClick" IsEnabled="False" Margin="0,0,8,0" />
                                        <Button x:Name="ProcessDirect" Content="Напрямую" Tag="direct" Click="RouteClick" IsEnabled="False" />
                                    </StackPanel>
                                    <TextBlock x:Name="TrafficSummary" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </DockPanel>
                                <Border x:Name="ProcessDetails" Background="{DynamicResource Background}" CornerRadius="8"
                                        Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="DetailTitle" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="DetailSummary" Style="{StaticResource MutedText}" Margin="0,0,0,6" TextWrapping="Wrap" />
                                        <ListBox x:Name="Destinations" MaxHeight="160" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Соединения и ошибки">
                                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Домены и адреса" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Всегда напрямую" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <ListBox x:Name="DirectRules" MinHeight="31" MaxHeight="110" AutomationProperties.Name="Прямые маршруты" />
                                        <TextBox x:Name="DirectEntry" AutomationProperties.Name="Домен или IP для прямого маршрута"
                                                 Tag="example.com или 1.2.3.0/24" MaxLength="200" Margin="0,7,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <Button Content="Добавить" Tag="direct:add" Click="DomainClick" Margin="0,0,8,0" />
                                            <Button Content="Удалить выбранное" Tag="direct:remove" Click="DomainClick" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Всегда через VPN" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <ListBox x:Name="ProxyRules" MinHeight="31" MaxHeight="110" AutomationProperties.Name="Маршруты через VPN" />
                                        <TextBox x:Name="ProxyEntry" AutomationProperties.Name="Домен или IP для VPN"
                                                 Tag="example.com или 1.2.3.0/24" MaxLength="200" Margin="0,7,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <Button Content="Добавить" Tag="proxy:add" Click="DomainClick" Margin="0,0,8,0" />
                                            <Button Content="Удалить выбранное" Tag="proxy:remove" Click="DomainClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>


            <TabItem Header="Настройки" x:Name="SettingsPage">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="6*" /><ColumnDefinition Width="5*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,7,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Подписка" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="SubscriptionHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,7" />
                                    <PasswordBox x:Name="SubscriptionUrl" AutomationProperties.Name="Ссылка на подписку VLESS" MaxLength="4096" />
                                    <CheckBox x:Name="AllowInsecure" Content="Разрешить непроверенный TLS-сертификат" Margin="0,11,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Сервер" Style="{StaticResource SectionTitle}" />
                                    <ComboBox x:Name="NodePicker" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="Сервер подписки" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button x:Name="SaveButton" Style="{StaticResource Primary}" Content="Сохранить" Click="SaveClick" Margin="0,0,8,0" />
                                        <Button Content="Обновить подписку" Click="UpdateClick" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Маршрутизация" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Режим" Style="{StaticResource MutedText}" Margin="0,0,0,5" />
                                    <ComboBox x:Name="ModePicker" SelectedValuePath="Tag" AutomationProperties.Name="Режим подключения">
                                        <ComboBoxItem Tag="tun" Content="Системный туннель (TUN)" />
                                        <ComboBoxItem Tag="proxy" Content="Локальный прокси" />
                                    </ComboBox>
                                    <TextBlock Text="Трафик без отдельного правила" Style="{StaticResource MutedText}" Margin="0,12,0,5" />
                                    <ComboBox x:Name="DefaultPicker" SelectedValuePath="Tag" AutomationProperties.Name="Маршрут по умолчанию">
                                        <ComboBoxItem Tag="proxy" Content="Через VPN" />
                                        <ComboBoxItem Tag="direct" Content="Напрямую" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Windows" Style="{StaticResource SectionTitle}" />
                                    <Button x:Name="AutostartButton" HorizontalAlignment="Left" Content="Включить автозапуск" Click="AutostartClick" />
                                    <Button Content="Импортировать настройки…" Click="ImportSettingsClick" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                    <Button Content="Открыть папку настроек" Click="OpenSettingsClick" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="Feedback" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,10,0,0" />
    </Grid>
</Window>
