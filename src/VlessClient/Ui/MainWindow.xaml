<Window x:Class="VlessClient.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VlessClient" Width="520" Height="680" MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8"
        FontFamily="Segoe UI" FontSize="15" Foreground="#1B1F24" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="Muted" Color="#5F6B7A" />
    <SolidColorBrush x:Key="Line" Color="#DCE1E8" />

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,16" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#1B1F24" />
      <Setter Property="BorderBrush" Value="#C9D0DA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" /><Setter TargetName="b" Property="BorderThickness" Value="2" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Padding="4,2" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
    <Style x:Key="H2" TargetType="TextBlock"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="13" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6" /><Setter Property="BorderBrush" Value="#C9D0DA" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6" /></Style>
    <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Margin" Value="0,4" /></Style>
    <Style TargetType="RadioButton"><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Margin" Value="0,4" /></Style>
  </Window.Resources>

  <Grid>
    <!-- ======================================================= first run: subscription link -->
    <ScrollViewer x:Name="SetupPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <StackPanel Margin="28,30,28,24">
        <TextBlock Text="Добро пожаловать в VlessClient" Style="{StaticResource H1}" FontSize="24" />
        <TextBlock Style="{StaticResource Hint}" FontSize="15" Margin="0,0,0,20"
                   Text="Чтобы включить VPN, нужна ссылка на подписку. Её даёт тот, кто выдал вам доступ к VPN. Скопируйте ссылку и вставьте её сюда." />
        <TextBlock Text="Ссылка на подписку" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox x:Name="SetupUrl" FontSize="14" MinHeight="40" MaxHeight="130" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Ссылка на подписку" />
        <Button Content="Вставить из буфера обмена" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="PasteClick" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Если ссылка не загружается, можно вставить сами серверы — строки, начинающиеся с vless://" />
        <Button x:Name="SetupButton" Content="Подключить" Style="{StaticResource Primary}" FontSize="17" Height="50" Margin="0,22,0,0" Click="SetupClick" IsDefault="True" />
        <TextBlock x:Name="SetupStatus" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="14" />
        <Button x:Name="SetupCancel" Content="Отмена" Style="{StaticResource Link}" HorizontalAlignment="Center" Margin="0,16,0,0" Click="BackClick" Visibility="Collapsed" />
      </StackPanel>
    </ScrollViewer>

    <!-- ======================================================= home: one big button -->
    <Grid x:Name="HomePage">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="24,10">
        <Button x:Name="BigButton" Width="210" Height="210" Cursor="Hand" Click="BigButtonClick" HorizontalAlignment="Center"
                AutomationProperties.Name="Включить или выключить VPN">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Ellipse x:Name="halo" Fill="{TemplateBinding Background}" Opacity="0.16" />
                <Ellipse x:Name="disc" Margin="18" Fill="{TemplateBinding Background}" />
                <Viewbox Margin="70">
                  <Path Stroke="White" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M 12,2 L 12,11 M 6.3,5.5 A 8.5,8.5 0 1 0 17.7,5.5" Width="24" Height="24" />
                </Viewbox>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="halo" Property="Opacity" Value="0.26" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="halo" Property="Opacity" Value="0.32" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="disc" Property="Margin" Value="22" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <TextBlock x:Name="StateText" Text="Загрузка…" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,6" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="StateHint" Text="" FontSize="15" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
        <Border x:Name="WarningBox" Background="#FFF7E6" BorderBrush="#F3C77B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,18,0,0" MaxWidth="440" Visibility="Collapsed">
          <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="14" Foreground="#7A4B00" />
        </Border>
        <Button x:Name="UpdateBanner" Style="{StaticResource Link}" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed" Click="OpenSettingsClick" />
      </StackPanel>
      <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
        <UniformGrid Columns="2">
          <Button Content="Настройки" Style="{StaticResource Btn}" Margin="0,0,6,0" Click="OpenSettingsClick" />
          <Button Content="Для продвинутых" Style="{StaticResource Btn}" Margin="6,0,0,0" Click="OpenAdvancedClick" />
        </UniformGrid>
      </Border>
    </Grid>

    <!-- ======================================================= settings (simple) -->
    <Grid x:Name="SettingsPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <DockPanel Margin="16,14,16,6">
        <Button Content="← Назад" Style="{StaticResource Link}" Click="BackClick" DockPanel.Dock="Left" FontSize="15" VerticalAlignment="Center" />
        <TextBlock Text="Настройки" Style="{StaticResource H1}" Margin="12,0,0,2" VerticalAlignment="Center" />
      </DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,4,16,16">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Сервер" Style="{StaticResource H2}" />
              <ComboBox x:Name="NodeBox" SelectionChanged="NodeChanged" AutomationProperties.Name="Сервер" />
              <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="«Автоматически» сам выбирает быстрый работающий сервер. Если какой-то сервер у вас работает лучше, выберите его — при сбое клиент временно перейдёт на запасной." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Подписка" Style="{StaticResource H2}" />
              <TextBlock x:Name="SubInfo" Style="{StaticResource Hint}" FontSize="14" />
              <WrapPanel Margin="0,10,0,0">
                <Button Content="Обновить список серверов" Style="{StaticResource Btn}" Margin="0,0,8,6" Click="RefreshSubClick" />
                <Button Content="Изменить ссылку" Style="{StaticResource Btn}" Margin="0,0,8,6" Click="ChangeSubClick" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Российские сайты" Style="{StaticResource H2}" />
              <CheckBox x:Name="RuDirectBox" Content="Открывать российские сайты напрямую, без VPN" Click="RuDirectClick" />
              <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Госуслуги, банки, Яндекс и другие российские сайты работают быстрее и без ограничений. Сайты, заблокированные в России, всё равно идут через VPN." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Обновления" Style="{StaticResource H2}" />
              <TextBlock x:Name="VersionText" FontSize="14" />
              <TextBlock x:Name="UpdateText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
              <WrapPanel Margin="0,10,0,0">
                <Button x:Name="CheckUpdateButton" Content="Проверить обновления" Style="{StaticResource Btn}" Margin="0,0,8,6" Click="CheckUpdateClick" />
                <Button x:Name="InstallUpdateButton" Content="Обновить" Style="{StaticResource Primary}" Margin="0,0,8,6" Click="InstallUpdateClick" Visibility="Collapsed" />
              </WrapPanel>
              <CheckBox x:Name="AutoUpdateBox" Content="Обновлять автоматически" Click="AutoUpdateClick" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Windows" Style="{StaticResource H2}" />
              <CheckBox x:Name="TrayBox" Content="Показывать значок VlessClient рядом с часами" Click="TrayClick" />
              <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="VPN включается сам при запуске компьютера, если он был включён. Значок только показывает состояние." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Помощь" Style="{StaticResource H2}" />
              <TextBlock Style="{StaticResource Hint}" Text="Если что-то не работает, сохраните отчёт и отправьте его тому, кто помогает вам с VPN. Ссылка на подписку в отчёт не попадает." />
              <Button Content="Сохранить отчёт на Рабочий стол" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ReportClick" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ======================================================= advanced -->
    <Grid x:Name="AdvancedPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <DockPanel Margin="16,14,16,6">
        <Button Content="← Назад" Style="{StaticResource Link}" Click="BackClick" DockPanel.Dock="Left" FontSize="15" VerticalAlignment="Center" />
        <TextBlock Text="Для продвинутых" Style="{StaticResource H1}" Margin="12,0,0,2" VerticalAlignment="Center" />
      </DockPanel>
      <TabControl x:Name="AdvancedTabs" Grid.Row="1" Margin="12,0,12,12" FontSize="14" SelectionChanged="AdvancedTabChanged">
        <TabItem Header="Программы">
          <Grid Margin="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Hint}" Text="Правила для программ: включено — через VPN, выключено — напрямую. Меняются сразу, без переподключения." />
            <ItemsControl x:Name="AppsList" Grid.Row="1" Margin="0,8,0,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#E5E9EF" BorderThickness="0,0,0,1" Padding="2,5">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Убрать" Style="{StaticResource Link}" Tag="{Binding Name}" Click="RemoveAppClick" />
                      <CheckBox DockPanel.Dock="Right" Content="через VPN" IsChecked="{Binding Vpn, Mode=OneWay}" Tag="{Binding Name}" Click="AppToggleClick" Margin="10,0" />
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProcessText}" Style="{StaticResource Hint}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DataGrid x:Name="TrafficGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E9EF" BorderBrush="{StaticResource Line}" RowHeight="30"
                      SelectionMode="Single" CanUserResizeRows="False" Sorting="TrafficSorting">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Программа" Binding="{Binding Exe}" SortMemberPath="Exe" Width="*" />
                <DataGridTextColumn Header="Скорость" Binding="{Binding Speed}" SortMemberPath="SpeedSort" Width="170" SortDirection="Descending" />
                <DataGridTextColumn Header="Всего" Binding="{Binding Total}" SortMemberPath="TotalBytes" Width="80" />
                <DataGridTextColumn Header="Куда идёт" Binding="{Binding Split}" SortMemberPath="VpnBytes" Width="150" />
                <DataGridTextColumn Header="Правило" Binding="{Binding RuleText}" SortMemberPath="RuleText" Width="95" />
              </DataGrid.Columns>
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Hosts}" /></Style>
              </DataGrid.RowStyle>
            </DataGrid>
            <TextBlock x:Name="TrafficEmpty" Grid.Row="2" Style="{StaticResource Hint}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="20" IsHitTestVisible="False"
                       Text="Здесь появятся программы, которые сейчас пользуются интернетом через VlessClient,&#10;с текущей скоростью и маршрутом. Наведите на строку, чтобы увидеть адреса." />
            <WrapPanel Grid.Row="3" Margin="0,8,0,0">
              <TextBlock Text="Выбранную программу:" VerticalAlignment="Center" Margin="0,0,8,6" Foreground="{StaticResource Muted}" />
              <Button Content="Через VPN" Style="{StaticResource Btn}" Margin="0,0,6,6" Tag="vpn" Click="RouteSelectedClick" />
              <Button Content="Напрямую" Style="{StaticResource Btn}" Margin="0,0,6,6" Tag="direct" Click="RouteSelectedClick" />
              <Button Content="Добавить программу…" Style="{StaticResource Btn}" Margin="12,0,0,6" Click="AddAppFileClick" />
            </WrapPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Сайты">
          <Grid Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Всегда напрямую" Style="{StaticResource H2}" />
            <TextBlock Grid.Column="2" Text="Всегда через VPN" Style="{StaticResource H2}" />
            <ListBox x:Name="DirectList" Grid.Row="1" FontFamily="Consolas" />
            <ListBox x:Name="ProxyList" Grid.Row="1" Grid.Column="2" FontFamily="Consolas" />
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
              <TextBox x:Name="DirectInput" AutomationProperties.Name="Сайт для прямого доступа" />
              <WrapPanel Margin="0,6,0,0">
                <Button Content="Добавить" Style="{StaticResource Btn}" Margin="0,0,6,0" Tag="direct:add" Click="DomainClick" />
                <Button Content="Убрать выбранное" Style="{StaticResource Btn}" Tag="direct:remove" Click="DomainClick" />
              </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0">
              <TextBox x:Name="ProxyInput" AutomationProperties.Name="Сайт через VPN" />
              <WrapPanel Margin="0,6,0,0">
                <Button Content="Добавить" Style="{StaticResource Btn}" Margin="0,0,6,0" Tag="proxy:add" Click="DomainClick" />
                <Button Content="Убрать выбранное" Style="{StaticResource Btn}" Tag="proxy:remove" Click="DomainClick" />
              </WrapPanel>
            </StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Серверы">
          <Grid Margin="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel>
              <Button x:Name="TestNodesButton" DockPanel.Dock="Right" Content="Проверить все серверы" Style="{StaticResource Btn}" Click="TestNodesClick" />
              <TextBlock x:Name="NodesHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Проверка: настоящее соединение через каждый сервер." />
            </DockPanel>
            <DataGrid x:Name="NodesGrid" Grid.Row="1" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E9EF" BorderBrush="{StaticResource Line}" RowHeight="28">
              <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Index}" Width="40" />
                <DataGridTextColumn Header="Сервер" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="140" />
                <DataGridTextColumn Header="Результат" Binding="{Binding Result}" SortMemberPath="Sort" Width="170" />
              </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="2" Margin="0,8,0,0">
              <TextBlock Text="Не использовать в «Автоматически» (часть имени или regex):" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,8,0" />
              <Button Content="Сохранить" Style="{StaticResource Btn}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="AutoExcludeClick" />
              <TextBox x:Name="AutoExcludeInput" />
            </DockPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Общее">
          <StackPanel Margin="12">
            <TextBlock Text="Сайты и программы без отдельного правила" Style="{StaticResource H2}" />
            <RadioButton x:Name="DefaultProxy" GroupName="def" Content="Через VPN" Click="DefaultClick" Tag="proxy" />
            <RadioButton x:Name="DefaultDirect" GroupName="def" Content="Напрямую (через VPN — только заблокированные в России сайты и выбранные программы)" Click="DefaultClick" Tag="direct" />
            <TextBlock x:Name="ProxyInfo" Style="{StaticResource Hint}" Margin="0,14,0,0" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Тонкие настройки (порты, DNS, рабочий VPN Check Point) — в файле C:\ProgramData\VlessClient\settings.json. После правки перезапустите службу VlessClient." />
          </StackPanel>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- busy overlay -->
    <Border x:Name="Busy" Background="#88F3F5F8" Visibility="Collapsed">
      <Border Background="White" CornerRadius="12" Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <TextBlock x:Name="BusyText" Text="Подождите…" FontSize="16" />
      </Border>
    </Border>
  </Grid>
</Window>
