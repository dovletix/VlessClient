<Window x:Class="VlessClient.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VlessClient" Width="520" Height="680" MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}"
        FontFamily="Segoe UI" FontSize="15" Foreground="{DynamicResource Text}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <!-- Colours come from Theme.cs (DynamicResource), the look follows the web UI of the PowerShell edition. -->
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,16" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="PanelBox" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="PanelHead" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource Accent}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Padding="4,2" Background="Transparent" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="5,1"><ContentPresenter VerticalAlignment="Center" /></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Bad}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HeaderBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="0,2"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" /></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BadgeBad" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Bad}" />
      <Setter Property="Background" Value="{DynamicResource BadSoft}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,6,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="8,1"><ContentPresenter /></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BadgeUdp" TargetType="Button" BasedOn="{StaticResource BadgeBad}">
      <Setter Property="Foreground" Value="{DynamicResource Warn}" />
      <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
    </Style>

    <Style x:Key="H1" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
    <Style x:Key="H2" TargetType="TextBlock"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="FontSize" Value="13" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="Sub" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,5" /></Style>
    <Style x:Key="Mono" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas" /><Setter Property="FontSize" Value="12.5" /></Style>
    <DataTemplate x:Key="ChipTemplate">
      <Border Background="{DynamicResource Chip}" CornerRadius="12" Padding="10,2,3,2" Margin="0,0,6,6">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Value}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
          <Button Content="✕" Style="{StaticResource Ghost}" Tag="{Binding}" Click="ChipRemoveClick" ToolTip="Убрать" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <Style x:Key="RunDot" TargetType="Ellipse">
      <Setter Property="Width" Value="8" /><Setter Property="Height" Value="8" /><Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource Line}" />
      <Style.Triggers><DataTrigger Binding="{Binding Running}" Value="True"><Setter Property="Fill" Value="{DynamicResource Ok}" /></DataTrigger></Style.Triggers>
    </Style>

    <!-- inputs -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Bg}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="9,6"><ContentPresenter /></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Chip}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Padding" Value="10,7,32,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer Margin="4" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" BorderBrush="{DynamicResource Track}" Background="{DynamicResource Bg}" VerticalAlignment="Center">
                <Path x:Name="mark" Data="M3.5,8.5 L6.5,11.5 L12.5,4.5" Stroke="{DynamicResource OnAccent}" StrokeThickness="2" Visibility="Collapsed" />
              </Border>
              <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="mark" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- the web UI's switch: on = through the VPN -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="40" Height="22" VerticalAlignment="Center">
                <Border x:Name="track" CornerRadius="11" Background="{DynamicResource Track}" />
                <Ellipse x:Name="thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0" />
              </Grid>
              <TextBlock x:Name="lbl" Text="Напрямую" Margin="9,0,0,0" MinWidth="78" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0" />
                <Setter TargetName="lbl" Property="Text" Value="Через VPN" />
                <Setter TargetName="lbl" Property="Foreground" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Grid Width="18" Height="18" VerticalAlignment="Center">
                <Ellipse x:Name="ring" Stroke="{DynamicResource Track}" StrokeThickness="1.5" Fill="{DynamicResource Bg}" />
                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
              </Grid>
              <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}" /></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}" /><Setter TargetName="dot" Property="Visibility" Value="Visible" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- tabs as pills -->
    <Style TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <DockPanel>
              <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,12" />
              <ContentPresenter ContentSource="SelectedContent" />
            </DockPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- colour and weight only on the header: a tab's content inherits the TabItem's own Foreground / FontWeight -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="14,6" Margin="0,0,6,0">
              <ContentPresenter x:Name="cp" ContentSource="Header" TextElement.Foreground="{DynamicResource Muted}" TextElement.FontWeight="SemiBold" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Chip}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}" /><Setter TargetName="cp" Property="TextElement.Foreground" Value="{DynamicResource Accent}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- thin scroll bars -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="t" Background="{DynamicResource Track}" CornerRadius="4" Margin="2" Opacity="0.7" />
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Opacity" Value="1" /></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="11" />
      <Setter Property="MinWidth" Value="11" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" /></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" /></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="Height" Value="11" />
          <Setter Property="MinHeight" Value="11" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}" /></Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}" /></Track.IncreaseRepeatButton>
                  <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="11,8">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- the servers table -->
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="AlternatingRowBackground" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HeadersVisibility" Value="Column" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="Transparent" Padding="10,0"><ContentPresenter VerticalAlignment="Center" /></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- ======================================================= first run: subscription link -->
    <ScrollViewer x:Name="SetupPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <StackPanel Margin="28,30,28,24">
        <TextBlock Text="Добро пожаловать в VlessClient" Style="{StaticResource H1}" FontSize="24" />
        <TextBlock Style="{StaticResource Hint}" FontSize="15" Margin="0,0,0,20"
                   Text="Чтобы включить VPN, нужна ссылка на подписку. Её даёт тот, кто выдал вам доступ к VPN. Скопируйте ссылку и вставьте её сюда." />
        <TextBlock Text="Ссылка на подписку" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox x:Name="SetupUrl" FontSize="14" MinHeight="40" MaxHeight="130" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Ссылка на подписку" />
        <Button Content="Вставить из буфера обмена" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="PasteClick" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Если ссылка не загружается, можно вставить сами серверы — строки, начинающиеся с vless://" />
        <Button x:Name="SetupButton" Content="Подключить" Style="{StaticResource Primary}" FontSize="17" Height="50" Margin="0,22,0,0" Click="SetupClick" IsDefault="True" />
        <TextBlock x:Name="SetupStatus" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="14" />
        <Button x:Name="SetupCancel" Content="Отмена" Style="{StaticResource Link}" HorizontalAlignment="Center" Margin="0,16,0,0" Click="BackClick" Visibility="Collapsed" />
      </StackPanel>
    </ScrollViewer>

    <!-- ======================================================= home: one big button -->
    <Grid x:Name="HomePage">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="24,10">
        <Button x:Name="BigButton" Width="210" Height="210" Cursor="Hand" Click="BigButtonClick" HorizontalAlignment="Center"
                AutomationProperties.Name="Включить или выключить VPN">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Ellipse x:Name="halo" Fill="{TemplateBinding Background}" Opacity="0.16" />
                <Ellipse x:Name="disc" Margin="18" Fill="{TemplateBinding Background}" />
                <Viewbox Margin="70">
                  <Path Stroke="White" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M 12,2 L 12,11 M 6.3,5.5 A 8.5,8.5 0 1 0 17.7,5.5" Width="24" Height="24" />
                </Viewbox>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="halo" Property="Opacity" Value="0.26" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="halo" Property="Opacity" Value="0.32" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="disc" Property="Margin" Value="22" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <TextBlock x:Name="StateText" Text="Загрузка…" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,6" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="StateHint" Text="" FontSize="15" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
        <Border x:Name="WarningBox" Background="{DynamicResource WarnSoft}" CornerRadius="10" Padding="14,10" Margin="0,18,0,0" MaxWidth="440" Visibility="Collapsed">
          <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource Warn}" />
        </Border>
        <Button x:Name="UpdateBanner" Style="{StaticResource Link}" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed" Click="OpenSettingsClick" />
      </StackPanel>
      <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
        <UniformGrid Columns="2">
          <Button Content="Настройки" Style="{StaticResource Btn}" Padding="14,8" Margin="0,0,6,0" Click="OpenSettingsClick" />
          <Button Content="Для продвинутых" Style="{StaticResource Btn}" Padding="14,8" Margin="6,0,0,0" Click="OpenAdvancedClick" />
        </UniformGrid>
      </Border>
    </Grid>

    <!-- ======================================================= settings (simple) -->
    <Grid x:Name="SettingsPage" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <DockPanel Margin="16,14,16,6">
        <Button Content="← Назад" Style="{StaticResource Link}" Click="BackClick" DockPanel.Dock="Left" FontSize="15" VerticalAlignment="Center" />
        <TextBlock Text="Настройки" Style="{StaticResource H1}" Margin="12,0,0,2" VerticalAlignment="Center" />
      </DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,4,16,16">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Сервер" Style="{StaticResource H2}" />
              <ComboBox x:Name="NodeBox" SelectionChanged="NodeChanged" AutomationProperties.Name="Сервер" />
              <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="«Автоматически» сам выбирает быстрый работающий сервер. Если какой-то сервер у вас работает лучше, выберите его — при сбое клиент временно перейдёт на запасной." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Подписка" Style="{StaticResource H2}" />
              <TextBlock x:Name="SubInfo" Style="{StaticResource Hint}" FontSize="14" />
              <WrapPanel Margin="0,10,0,0">
                <Button Content="Обновить список серверов" Style="{StaticResource Btn}" Margin="0,0,8,6" Click="RefreshSubClick" />
                <Button Content="Изменить ссылку" Style="{StaticResource Btn}" Margin="0,0,8,6" Click="ChangeSubClick" />
              </WrapPanel>
              <TextBlock Text="Запасные подписки" FontWeight="SemiBold" Margin="0,14,0,4" />
              <TextBlock Style="{StaticResource Hint}" Text="Если основная подписка не загружается или ни один её сервер не отвечает, клиент возьмёт серверы из запасной. Подойдёт та же подписка по другому адресу (например, через другой сервер) или подписка другого сервиса." />
              <ItemsControl x:Name="BackupList" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,8">
                      <Button DockPanel.Dock="Right" Content="Убрать" Style="{StaticResource Btn}" Margin="8,0,0,0" VerticalAlignment="Center" Tag="{Binding Url}" Click="BackupRemoveClick" />
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Info}" Style="{StaticResource Hint}" />
                        <TextBlock Text="{Binding Error}" Style="{StaticResource Hint}" Foreground="{DynamicResource Bad}" Visibility="{Binding ErrorVisibility}" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Right" Content="Добавить" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="BackupAddClick" />
                <Grid>
                  <TextBox x:Name="BackupInput" TextChanged="PlaceholderChanged" AutomationProperties.Name="Ссылка на запасную подписку" />
                  <TextBlock x:Name="BackupHint" Text="https://… ссылка на запасную подписку" Foreground="{DynamicResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
              </DockPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Российские сайты" Style="{StaticResource H2}" />
              <CheckBox x:Name="RuDirectBox" Content="Открывать российские сайты напрямую, без VPN" Click="RuDirectClick" />
              <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Госуслуги, банки, Яндекс и другие российские сайты работают быстрее и без ограничений. Сайты, заблокированные в России, всё равно идут через VPN." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Оформление" Style="{StaticResource H2}" />
              <RadioButton x:Name="ThemeDark" GroupName="theme" Content="Тёмное" Click="ThemeClick" Tag="dark" />
              <RadioButton x:Name="ThemeLight" GroupName="theme" Content="Светлое" Click="ThemeClick" Tag="light" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Обновления" Style="{StaticResource H2}" />
              <TextBlock x:Name="VersionText" FontSize="14" />
              <TextBlock x:Name="UpdateText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
              <WrapPanel Margin="0,10,0,0">
                <Button x:Name="CheckUpdateButton" Content="Проверить обновления" Style="{StaticResource Btn}" Margin="0,0,8,6" Click="CheckUpdateClick" />
                <Button x:Name="InstallUpdateButton" Content="Обновить" Style="{StaticResource Primary}" Margin="0,0,8,6" Click="InstallUpdateClick" Visibility="Collapsed" />
              </WrapPanel>
              <CheckBox x:Name="AutoUpdateBox" Content="Обновлять автоматически" Click="AutoUpdateClick" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Windows" Style="{StaticResource H2}" />
              <CheckBox x:Name="TrayBox" Content="Показывать значок VlessClient рядом с часами" Click="TrayClick" />
              <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="VPN включается сам при запуске компьютера, если он был включён. Значок только показывает состояние." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Помощь" Style="{StaticResource H2}" />
              <TextBlock Style="{StaticResource Hint}" Text="Если что-то не работает, сохраните отчёт и отправьте его тому, кто помогает вам с VPN. Ссылка на подписку в отчёт не попадает." />
              <Button Content="Сохранить отчёт на Рабочий стол" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ReportClick" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ======================================================= advanced (the web UI) -->
    <Grid x:Name="AdvancedPage" Visibility="Collapsed" TextElement.FontSize="14">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <DockPanel Margin="16,14,16,10" LastChildFill="True">
        <Button Content="← Назад" Style="{StaticResource Link}" Click="BackClick" DockPanel.Dock="Left" FontSize="15" VerticalAlignment="Center" />
        <TextBlock Text="Для продвинутых" FontSize="20" FontWeight="SemiBold" Margin="12,0,14,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
        <Border x:Name="AdvPill" CornerRadius="11" Padding="11,3" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,16,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="AdvPillDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" />
            <TextBlock x:Name="AdvPillText" FontWeight="SemiBold" FontSize="13" />
          </StackPanel>
        </Border>
        <TextBlock x:Name="AdvFacts" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
      <TabControl x:Name="AdvancedTabs" Grid.Row="1" Margin="16,0,16,14" SelectionChanged="AdvancedTabChanged">
        <TabItem Header="Программы">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer x:Name="ProgramsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <!-- apps -->
                <Border Style="{StaticResource PanelBox}">
                  <StackPanel>
                    <Border Style="{StaticResource PanelHead}">
                      <WrapPanel>
                        <TextBlock Text="Приложения" FontSize="15" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Переключатель включён — программа ходит через VPN, выключен — напрямую. Применяется сразу." />
                      </WrapPanel>
                    </Border>
                    <StackPanel Margin="16,14,16,14">
                      <ItemsControl x:Name="AppsList">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Width="250" Margin="0,0,12,12" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10">
                              <StackPanel>
                                <DockPanel>
                                  <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource Ghost}" Tag="{Binding Name}" Click="RemoveAppClick"
                                          ToolTip="Убрать: программа будет идти по общим правилам" />
                                  <Ellipse Style="{StaticResource RunDot}" Margin="0,0,8,0" ToolTip="Зелёный — программа запущена" />
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding ProcessText}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,8" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Vpn, Mode=OneWay}" Tag="{Binding Name}" Click="AppToggleClick" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock x:Name="AppsEmpty" Style="{StaticResource Hint}" Margin="0,0,0,10" Visibility="Collapsed" Text="Пока пусто. Добавьте программу из списка процессов ниже." />
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Выбрать файл…" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="AddAppFileClick" />
                        <Button DockPanel.Dock="Right" Content="Напрямую" Style="{StaticResource Btn}" Margin="8,0,0,0" Tag="direct" Click="AddExeClick" />
                        <Button DockPanel.Dock="Right" Content="Через VPN" Style="{StaticResource Btn}" Margin="8,0,0,0" Tag="vpn" Click="AddExeClick" />
                        <Grid>
                          <TextBox x:Name="AddExeInput" TextChanged="PlaceholderChanged" AutomationProperties.Name="Добавить программу по имени" />
                          <TextBlock x:Name="AddExeHint" Text="Добавить вручную: имя.exe" Foreground="{DynamicResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                      </DockPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- processes -->
                <Border Style="{StaticResource PanelBox}" Margin="0">
                  <StackPanel>
                    <Border Style="{StaticResource PanelHead}">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Сбросить статистику" Style="{StaticResource Btn}" Click="ResetStatsClick" />
                        <WrapPanel>
                          <TextBlock Text="Процессы" FontSize="15" FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Center" />
                          <Grid Width="200" Margin="0,0,14,0">
                            <TextBox x:Name="SearchBox" TextChanged="SearchChanged" AutomationProperties.Name="Поиск по имени" />
                            <TextBlock x:Name="SearchHint" Text="Поиск по имени" Foreground="{DynamicResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                          </Grid>
                          <CheckBox x:Name="ShowAllBox" Content="все запущенные" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,14,0" Click="FilterClick" />
                          <CheckBox x:Name="OnlyBadBox" Content="только с проблемами" Foreground="{DynamicResource Muted}" FontSize="13" Click="FilterClick" />
                        </WrapPanel>
                      </DockPanel>
                    </Border>
                    <!-- column headers: same widths as the rows -->
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="125" /><ColumnDefinition Width="110" /><ColumnDefinition Width="95" />
                          <ColumnDefinition Width="210" /><ColumnDefinition Width="160" /><ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="HName" Grid.Column="0" Style="{StaticResource HeaderBtn}" Margin="14,0,0,0" HorizontalAlignment="Left" Tag="name" Content="Процесс" Click="HeaderSortClick" />
                        <Button x:Name="HSpeed" Grid.Column="1" Style="{StaticResource HeaderBtn}" HorizontalAlignment="Right" Margin="0,0,10,0" Tag="speed" Content="Скорость" Click="HeaderSortClick" />
                        <Button x:Name="HTotal" Grid.Column="2" Style="{StaticResource HeaderBtn}" HorizontalAlignment="Right" Margin="0,0,10,0" Tag="total" Content="Всего" Click="HeaderSortClick" />
                        <Button x:Name="HConns" Grid.Column="3" Style="{StaticResource HeaderBtn}" HorizontalAlignment="Right" Margin="0,0,10,0" Tag="conns" Content="Соединения" Click="HeaderSortClick" />
                        <Button x:Name="HVpn" Grid.Column="4" Style="{StaticResource HeaderBtn}" HorizontalAlignment="Left" Margin="10,0,0,0" Tag="vpn" Content="Куда идёт" Click="HeaderSortClick" />
                        <Button x:Name="HFail" Grid.Column="5" Style="{StaticResource HeaderBtn}" HorizontalAlignment="Left" Tag="fail" Content="Проблемы" Click="HeaderSortClick" />
                        <TextBlock Grid.Column="6" Text="Маршрут" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,14,0" />
                      </Grid>
                    </Border>
                    <ItemsControl x:Name="ProcList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border x:Name="rowb" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Background="Transparent">
                            <StackPanel>
                              <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="125" /><ColumnDefinition Width="110" /><ColumnDefinition Width="95" />
                                  <ColumnDefinition Width="210" /><ColumnDefinition Width="160" /><ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <!-- name: hover shows where it goes, click opens the details -->
                                <StackPanel Background="Transparent" Cursor="Hand" Margin="14,0,8,0" MouseLeftButtonUp="RowToggle"
                                            ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="60000">
                                  <StackPanel.ToolTip>
                                    <ToolTip>
                                      <StackPanel MaxWidth="620">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding TipHosts}">
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                              <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Host}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                <TextBlock x:Name="r" Grid.Column="1" Text="{Binding RouteText}" FontWeight="SemiBold" Foreground="{DynamicResource Ok}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Totals}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                              </Grid>
                                              <DataTemplate.Triggers><DataTrigger Binding="{Binding Vpn}" Value="True"><Setter TargetName="r" Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger></DataTemplate.Triggers>
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding TipFails}" Visibility="{Binding TipFailsVisibility}" Foreground="{DynamicResource Bad}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding TipTitle}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                      </StackPanel>
                                    </ToolTip>
                                  </StackPanel.ToolTip>
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Chevron}" Width="13" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" />
                                    <Ellipse Style="{StaticResource RunDot}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AppSuffix}" Foreground="{DynamicResource Muted}" FontSize="12.5" VerticalAlignment="Center" />
                                  </StackPanel>
                                  <TextBlock Text="{Binding Path}" Visibility="{Binding PathVisibility}" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="28,1,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,10,0">
                                  <TextBlock x:Name="sd" Text="{Binding SpeedDown}" HorizontalAlignment="Right" />
                                  <TextBlock Text="{Binding SpeedUp}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,10,0">
                                  <TextBlock Text="{Binding TotalDown}" HorizontalAlignment="Right" />
                                  <TextBlock Text="{Binding TotalUp}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" Margin="0,0,10,0">
                                  <Run Text="{Binding ConnsActive, Mode=OneWay}" /><Run Text="{Binding ConnsTotal, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                </TextBlock>
                                <StackPanel Grid.Column="4" Margin="10,0,8,0">
                                  <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding VpnPart, Mode=OneWay}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" /><Run Text="{Binding RouteSep, Mode=OneWay}" /><Run Text="{Binding DirectPart, Mode=OneWay}" Foreground="{DynamicResource Ok}" FontWeight="SemiBold" />
                                  </TextBlock>
                                  <TextBlock Text="—" Foreground="{DynamicResource Muted}" Visibility="{Binding RouteNoneVisibility}" />
                                  <Border Width="120" Height="5" CornerRadius="3" HorizontalAlignment="Left" Margin="0,5,0,0" Background="{DynamicResource Line}" ClipToBounds="True"
                                          Visibility="{Binding BarVisibility}" ToolTip="{Binding BarTip}">
                                    <Grid>
                                      <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding BarVpn}" /><ColumnDefinition Width="{Binding BarDirect}" /></Grid.ColumnDefinitions>
                                      <Rectangle Fill="{DynamicResource Accent}" />
                                      <Rectangle Grid.Column="1" Fill="{DynamicResource Ok}" />
                                    </Grid>
                                  </Border>
                                </StackPanel>
                                <WrapPanel Grid.Column="5" VerticalAlignment="Top">
                                  <Button Content="{Binding FailText}" Style="{StaticResource BadgeBad}" Visibility="{Binding FailVisibility}" Click="RowExpandClick" ToolTip="Показать адреса" />
                                  <Button Content="{Binding UdpText}" Style="{StaticResource BadgeUdp}" Visibility="{Binding UdpVisibility}" Click="RowExpandClick" ToolTip="UDP-пакеты без ответа — часто это норма" />
                                  <TextBlock Text="{Binding NoProblems}" Foreground="{DynamicResource Muted}" />
                                </WrapPanel>
                                <Grid Grid.Column="6" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Top">
                                  <CheckBox Style="{StaticResource Switch}" Visibility="{Binding SwitchVisibility}" IsChecked="{Binding Vpn, Mode=OneWay}" Tag="{Binding AppName}" Click="AppToggleClick" />
                                  <StackPanel Orientation="Horizontal" Visibility="{Binding ButtonsVisibility}">
                                    <Button Content="Через VPN" Style="{StaticResource SmallBtn}" Tag="vpn" Click="RowRouteClick" Margin="0,0,6,0" />
                                    <Button Content="Напрямую" Style="{StaticResource SmallBtn}" Tag="direct" Click="RowRouteClick" />
                                  </StackPanel>
                                  <TextBlock Text="правило задать нельзя" Foreground="{DynamicResource Muted}" FontSize="12" Visibility="{Binding UnknownVisibility}"
                                             ToolTip="Сбой соединения, который не удалось привязать к программе. Адреса — в столбце «Проблемы»." />
                                </Grid>
                              </Grid>
                              <!-- details: where it goes, what fails -->
                              <Border Background="{DynamicResource Bg}" Padding="42,10,14,12" Visibility="{Binding DetailsVisibility}">
                                <StackPanel>
                                  <StackPanel Visibility="{Binding HostsVisibility}">
                                    <TextBlock Text="{Binding HostsHeader}" Style="{StaticResource Sub}" />
                                    <Grid Margin="0,0,0,2">
                                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="180" /><ColumnDefinition Width="90" /><ColumnDefinition Width="200" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                      <TextBlock Text="Адрес" Foreground="{DynamicResource Muted}" FontSize="11.5" />
                                      <TextBlock Grid.Column="1" Text="Маршрут" Foreground="{DynamicResource Muted}" FontSize="11.5" />
                                      <TextBlock Grid.Column="2" Text="Сейчас" Foreground="{DynamicResource Muted}" FontSize="11.5" />
                                      <TextBlock Grid.Column="3" Text="Всего" Foreground="{DynamicResource Muted}" FontSize="11.5" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Hosts}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="180" /><ColumnDefinition Width="90" /><ColumnDefinition Width="200" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Host}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding Host}" />
                                            <TextBlock x:Name="r" Grid.Column="1" Text="{Binding RouteText}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Ok}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Now}" FontSize="12.5" />
                                            <TextBlock Grid.Column="3" Text="{Binding Totals}" FontSize="12.5" Foreground="{DynamicResource Muted}" />
                                          </Grid>
                                          <DataTemplate.Triggers><DataTrigger Binding="{Binding Vpn}" Value="True"><Setter TargetName="r" Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger></DataTemplate.Triggers>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                  <StackPanel Visibility="{Binding FailsVisibility}" Margin="0,10,0,0">
                                    <TextBlock Text="Соединения без ответа" Style="{StaticResource Sub}" />
                                    <ItemsControl ItemsSource="{Binding Fails}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" MinWidth="180" /><ColumnDefinition Width="90" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Muted}" FontSize="12.5" />
                                            <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0,0,10,0">
                                              <Run Text="{Binding Dest, Mode=OneWay}" FontFamily="Consolas" FontSize="12.5" /><Run Text="{Binding Count, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12.5" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding RouteText}" FontSize="12.5" />
                                            <TextBlock Grid.Column="3" Text="{Binding Reason}" Foreground="{DynamicResource Muted}" FontSize="12.5" />
                                          </Grid>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Advice}" Visibility="{Binding AdviceVisibility}" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                                  </StackPanel>
                                </StackPanel>
                              </Border>
                            </StackPanel>
                          </Border>
                          <DataTemplate.Triggers>
                            <Trigger SourceName="rowb" Property="IsMouseOver" Value="True"><Setter TargetName="rowb" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                            <DataTrigger Binding="{Binding Hot}" Value="True"><Setter TargetName="sd" Property="FontWeight" Value="SemiBold" /></DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ProcEmpty" Style="{StaticResource Hint}" FontSize="14" HorizontalAlignment="Center" Margin="20,26" Text="Ничего не найдено" Visibility="Collapsed" />
                    <TextBlock x:Name="StatNote" Style="{StaticResource Hint}" FontSize="12.5" Margin="16,12,16,14" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <!-- totals, always visible -->
            <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,8" Margin="0,10,0,0">
              <TextBlock x:Name="TotalsText" FontSize="13" />
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="Сайты">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource PanelBox}">
              <StackPanel>
                <Border Style="{StaticResource PanelHead}">
                  <WrapPanel>
                    <TextBlock Text="Домены и адреса" FontSize="15" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="RuNote" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                  </WrapPanel>
                </Border>
                <Grid Margin="16,14">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Всегда напрямую" FontWeight="SemiBold" />
                    <Grid Margin="0,10" MinHeight="28">
                      <ItemsControl x:Name="DirectChips" ItemTemplate="{StaticResource ChipTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <TextBlock x:Name="DirectEmpty" Text="пусто" Foreground="{DynamicResource Muted}" FontSize="12.5" VerticalAlignment="Center" />
                    </Grid>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Добавить" Style="{StaticResource Btn}" Margin="8,0,0,0" Tag="direct" Click="DomainAddClick" />
                      <Grid>
                        <TextBox x:Name="DirectInput" TextChanged="PlaceholderChanged" AutomationProperties.Name="Сайт для прямого доступа" />
                        <TextBlock x:Name="DirectHint" Text="example.com или 1.2.3.0/24" Foreground="{DynamicResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                      </Grid>
                    </DockPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Всегда через VPN" FontWeight="SemiBold" />
                    <Grid Margin="0,10" MinHeight="28">
                      <ItemsControl x:Name="ProxyChips" ItemTemplate="{StaticResource ChipTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <TextBlock x:Name="ProxyEmpty" Text="пусто" Foreground="{DynamicResource Muted}" FontSize="12.5" VerticalAlignment="Center" />
                    </Grid>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Добавить" Style="{StaticResource Btn}" Margin="8,0,0,0" Tag="proxy" Click="DomainAddClick" />
                      <Grid>
                        <TextBox x:Name="ProxyInput" TextChanged="PlaceholderChanged" AutomationProperties.Name="Сайт через VPN" />
                        <TextBlock x:Name="ProxyHint" Text="example.ru или 1.2.3.0/24" Foreground="{DynamicResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                      </Grid>
                    </DockPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Серверы">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel>
              <Button x:Name="TestNodesButton" DockPanel.Dock="Right" Content="Проверить все серверы" Style="{StaticResource Btn}" Click="TestNodesClick" />
              <TextBlock x:Name="NodesHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Проверка: настоящее соединение через каждый сервер." />
            </DockPanel>
            <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource PanelBox}" ClipToBounds="True">
              <DataGrid x:Name="NodesGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" RowHeight="32" Margin="4">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="№" Binding="{Binding Index}" Width="44" />
                  <DataGridTextColumn Header="Сервер" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="150" />
                  <DataGridTextColumn Header="Результат" Binding="{Binding Result}" SortMemberPath="Sort" Width="170" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,10,0,0">
              <TextBlock Text="Не использовать в «Автоматически» (часть имени или regex):" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,8,0" />
              <Button Content="Сохранить" Style="{StaticResource Btn}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="AutoExcludeClick" />
              <TextBox x:Name="AutoExcludeInput" />
            </DockPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Общее">
          <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Сайты и программы без отдельного правила" Style="{StaticResource H2}" />
              <RadioButton x:Name="DefaultProxy" GroupName="def" Content="Через VPN" Click="DefaultClick" Tag="proxy" />
              <RadioButton x:Name="DefaultDirect" GroupName="def" Content="Напрямую (через VPN — только заблокированные в России сайты и выбранные программы)" Click="DefaultClick" Tag="direct" />
              <TextBlock x:Name="ProxyInfo" Style="{StaticResource Hint}" Margin="0,14,0,0" />
              <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Тонкие настройки (порты, DNS, рабочий VPN Check Point) — в файле C:\ProgramData\VlessClient\settings.json. После правки перезапустите службу VlessClient." />
            </StackPanel>
          </Border>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- busy overlay -->
    <Border x:Name="Busy" Background="{DynamicResource Overlay}" Visibility="Collapsed">
      <Border Background="{DynamicResource Panel}" CornerRadius="12" Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <TextBlock x:Name="BusyText" Text="Подождите…" FontSize="16" />
      </Border>
    </Border>
  </Grid>
</Window>
